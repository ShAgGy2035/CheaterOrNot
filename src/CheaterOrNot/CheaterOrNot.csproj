<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\question-mark.ico</ApplicationIcon>
    <BrowserBundlePath Condition="'$(BrowserBundlePath)' == ''">$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\browsers</BrowserBundlePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\question-mark.png" />
    <AvaloniaResource Include="Assets\leetify-logo.png" />
    <Content Include="Assets\demo-parser-notices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\capture-tool-notices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <ProjectReference Include="..\CheaterOrNot.Core\CheaterOrNot.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
    <Content Include="$(BrowserBundlePath)\**\*">
      <Link>browsers\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="ValidatePortableBrowserBundle" BeforeTargets="PrepareForPublish" Condition="'$(PublishSingleFile)' == 'true'">
    <Error Condition="!Exists('$(BrowserBundlePath)')" Text="Install the matching Chromium Headless Shell first, or set BrowserBundlePath to its browser bundle directory. Portable publishing requires browser binaries and vendor notices." />
  </Target>
  <Target Name="ExcludePortableDebugSymbols" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
